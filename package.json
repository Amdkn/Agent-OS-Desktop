{
  "name": "agent-os-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node --experimental-strip-types src/contracts/truth.test.ts",
    "test:api": "node --experimental-strip-types src/api/projection.test.ts",
    "test:canary": "node --experimental-strip-types src/apps/CanaryHarness/canary.test.ts && node --experimental-strip-types src/contracts/issue237-integration.test.ts",
    "test": "npm run test:contracts && npm run test:api && npm run test:canary && npm run test:live-canary-contract",
    "test:live-canary-contract": "node --experimental-strip-types tools/live-projection-canary.test.ts",
    "canary:live": "node --experimental-strip-types tools/live-projection-canary.ts"
  },
  "dependencies": {
    "lucide-react": "^1.42.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^26.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.5"
  }
}
